# ─────────────────────────────────────────────────────────────────────────────
# ARCANA backend — environment configuration
#
# Copy this file to `.env` for local development, then adjust as needed:
#     cp .env.example .env
#
# Never commit a real `.env` (it is git-ignored). All values below are safe
# local-development placeholders, not real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Application ----------------------------------------------------------------
APP_NAME=ARCANA
APP_ENV=development            # development | testing | staging | production
APP_VERSION=0.1.0
DEBUG=true

# API ------------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# Database -------------------------------------------------------------------
# Matches the PostgreSQL service in docker-compose.yml at the repository root.
DATABASE_URL=postgresql+psycopg://arcana:arcana@localhost:5432/arcana

# Connection pooling (development defaults; tune for production).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=5

# Authentication --------------------------------------------------------------
# Local-development placeholder only. Production MUST set a strong secret
# (>= 32 characters); the application refuses to start otherwise.
JWT_SECRET_KEY=arcana-insecure-development-secret-change-me-now
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=8

# Integration tests only — a dedicated, disposable test database. Never set this
# to the development/production database (tests refuse such a value).
# ARCANA_TEST_DATABASE_URL=postgresql+psycopg://arcana:arcana@localhost:5432/arcana_test

# CORS -----------------------------------------------------------------------
# Comma-separated list of allowed browser origins. No wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
